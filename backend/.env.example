# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=true

# AI Provider Keys (Optional: You can provide these here or via the web app UI)
# Get a free Google Gemini API key at: https://aistudio.google.com/
GEMINI_API_KEY=
# Get an OpenAI API key at: https://platform.openai.com/
OPENAI_API_KEY=

# MongoDB Configuration
# TubeSage AI connects to MongoDB if available, otherwise seamlessly defaults to local SQLite.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=tubesage_ai
